# Copy to .env and fill values (never commit real secrets)

# Azure OpenAI (preferred)
#
# Create/choose an Azure OpenAI resource and deployments (names below).
# Endpoint looks like: https://<resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Deployment names (Azure uses deployment names in the "model" field).
# Set this to YOUR Azure OpenAI deployment name for the chat model you want to use.
# If you create a "gpt-4o-mini" deployment, you can keep the default below.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# IMPORTANT: keep embeddings at 1536 dimensions (text-embedding-3-small).
# Do not point this at a 3072-dim deployment (e.g. text-embedding-3-large).
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=embed-3-small

# LiteLLM compatibility (ADK agent). Many LiteLLM setups use these names.
# Keep them in sync with the AZURE_OPENAI_* vars above.
AZURE_API_BASE=
AZURE_API_KEY=
AZURE_API_VERSION=

# OpenAI (fallback only)
OPENAI_API_KEY=

# Optional: for OpenAI fallback, change embedding model.
# For Azure OpenAI, the deployment name controls the underlying model.
EMBEDDING_MODEL=text-embedding-3-small

# FastMCP server
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000
FASTMCP_PATH=/mcp

# If using OAuth in production, this must be your public base URL
# FASTMCP_BASE_URL=

# OAuth 2.0 (RemoteAuthProvider) - enable only if you have an IdP + JWT settings
AUTH_ENABLED=false
# AUTH_JWKS_URI=https://YOUR_IDP/.well-known/jwks.json
# AUTH_ISSUER=https://YOUR_IDP
# AUTH_AUDIENCE=YOUR_API_AUDIENCE
# AUTHORIZATION_SERVERS=https://YOUR_IDP
# AUTH_ALLOWED_REDIRECT_URIS=https://*,http://localhost:*

# Simple bearer token (optional, both services share the same key)
MCP_API_KEY=

# ADK Agent
ADK_PORT=8080
# For Azure OpenAI via LiteLLM, this should match your Azure deployment name.
# docker-compose derives this automatically from AZURE_OPENAI_CHAT_DEPLOYMENT.
OPENAI_MODEL=azure/gpt-4o-mini
# MCP_SERVER_URL is set automatically in docker-compose; override for external MCP servers
# MCP_SERVER_URL=http://localhost:8000/mcp
